    "mbert":    {"ten": "bert-base-multilingual-cased",  "muc_du_lieu": "muc_am_tiet", "nguoi": "Yến Trinh"},
    "phobert_khong_tach_tu": {"ten": "vinai/phobert-base", "muc_du_lieu": "muc_am_tiet", "nguoi": "Phúc", "ghi_chu": "Yêu cầu nâng cao (sau BC1)"}
